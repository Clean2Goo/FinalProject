<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
      PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
   "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="mapper.member">
    <resultMap id="memResult" type="memberVO">
        <result property="id" column="USERID" />
        <result property="pwd" column="USERPWD" />
        <result property="name" column="USERNAME" />
        <result property="email" column="USEREMAIL" />
        <result property="number" column="USERPHONE" />
        <result property="role" column="USERTYPE" />
        <result property="joinDate" column="JOINDATE" />
    </resultMap> 
    
    <!-- 회원 전체 목록 조회 -->
    <select id="selectAllMemberList" resultMap="memResult">
        <![CDATA[
            SELECT * FROM USERS ORDER BY JOINDATE DESC
        ]]>
    </select>
    
    <!-- 회원 가입 -->
    <insert id="insertMember" parameterType="memberVO">
        <![CDATA[
            INSERT INTO USERS (USERID, USERPWD, USERNAME, USEREMAIL, USERPHONE, USERTYPE, JOINDATE)
            VALUES (#{id}, #{pwd}, #{name}, #{email}, #{number}, #{role}, SYSDATE)
        ]]>
    </insert>
    
    <!-- 회원 정보 수정 -->
    <update id="updateMember" parameterType="memberVO">
        <![CDATA[
            UPDATE USERS
            SET USERPWD = #{pwd}, USERNAME = #{name}, USEREMAIL = #{email}, USERTYPE = #{role}
            WHERE USERID = #{id}
        ]]>
    </update>
     
    <!-- 회원 삭제 -->
    <delete id="deleteMember" parameterType="String">
        <![CDATA[
            DELETE FROM USERS
            WHERE USERID = #{id}
        ]]>
    </delete>
    
    <!-- 로그인 체크 -->
    <select id="loginById" resultMap="memResult" parameterType="memberVO">
        <![CDATA[
            SELECT * FROM USERS
            WHERE USERID = #{id} AND USERPWD = #{pwd}
        ]]>
    </select>
</mapper>
